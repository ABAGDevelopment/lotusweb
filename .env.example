# Client-side config. No VITE_ prefix: vite.config.ts inlines exactly the
# variables listed in CLIENT_ENV_VARS, so secrets cannot leak into the bundle.
# Sanity project the website reads from.
# Find these in the Studio's sanity.config.ts or at https://www.sanity.io/manage
SANITY_PROJECT_ID=rh6f9d38
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01

# Leave false so published changes appear instantly.
# Set to true to serve reads from the CDN (cheaper, up to ~60s stale).
SANITY_USE_CDN=false

# Where the test-drive form POSTs. Leave empty in development: submissions are
# logged to the console with a warning instead of being silently dropped.
# In production point this at your own endpoint (see apps/web/api/test-drive.ts),
# or at Formspree / Zapier / your CRM.
ENQUIRY_ENDPOINT=/api/test-drive

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — read by api/test-drive.ts and api/offer-enquiry.ts,
# never bundled.
# Deliberately absent from CLIENT_ENV_VARS in vite.config.ts: a write token in
# the browser lets anyone rewrite the dataset.
# ---------------------------------------------------------------------------
SANITY_WRITE_TOKEN=
# A token with the Editor role, created at https://www.sanity.io/manage
# (API > Tokens). Set it in .env locally and in the Vercel project settings.
# Never put a real value in this file: it is committed.
# SANITY_API_WRITE_TOKEN (the name Vercel's Sanity integration uses) also works.
#
# The offer enquiry form needs no extra variables: it always posts to
# /api/offer-enquiry, which stores enquiries in SANITY_DATASET.
