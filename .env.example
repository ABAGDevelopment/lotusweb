# Sanity project the website reads from.
# Find these in the Studio's sanity.config.ts or at https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=rh6f9d38
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Leave false so published changes appear instantly.
# Set to true to serve reads from the CDN (cheaper, up to ~60s stale).
VITE_SANITY_USE_CDN=false

# Where the test-drive form POSTs. Leave empty in development: submissions are
# logged to the console with a warning instead of being silently dropped.
# In production point this at your own endpoint (see apps/web/api/test-drive.ts),
# or at Formspree / Zapier / your CRM.
VITE_ENQUIRY_ENDPOINT=
